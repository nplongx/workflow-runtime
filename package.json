{
  "name": "@runalith/workflow-runtime",
  "version": "0.3.16",
  "description": "Local-first, SQLite-backed durable workflow lifecycle and agent-session runtime.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./legacy": "./job-store.js",
    "./database": "./src/runtime/workflow-database.js",
    "./execution-contract": "./src/runtime/execution-contract.js",
    "./workflow-plan": "./src/runtime/workflow-plan-public-api.js",
    "./phases": "./src/runtime/workflow/phases.js",
    "./artifact-normalizer": "./src/runtime/workflow/artifact-normalizer.js",
    "./success-contract": "./src/runtime/workflow/success-contract.js",
    "./roles": "./src/runtime/workflow/roles.js",
    "./role-profiles": "./src/runtime/workflow/role-profiles.js",
    "./evidence": "./src/runtime/workflow/evidence.js",
    "./workspace-write-contract": "./src/runtime/workflow/workspace-write-contract.js",
    "./agent-contracts": "./src/runtime/workflow/agent-contracts.js",
    "./workflow-definitions/index": "./src/runtime/workflow/definitions/index.js",
    "./workflow-definitions/engineering": "./src/runtime/workflow/definitions/engineering.js",
    "./workflow-definitions/hybrid-engineering": "./src/runtime/workflow/definitions/hybrid-engineering.js",
    "./workflow-definitions/production": "./src/runtime/workflow/definitions/production.js",
    "./workflow-definitions/standard-engineering": "./src/runtime/workflow/definitions/standard-engineering.js",
    "./workflow-catalog/engineering": "./src/runtime/workflow/catalog/engineering.js",
    "./workflow-catalog/hybrid-engineering": "./src/runtime/workflow/catalog/hybrid-engineering.js",
    "./workflow-catalog/standard-engineering": "./src/runtime/workflow/catalog/standard-engineering.js",
    "./recovery-compatibility": "./src/runtime/workflow/recovery-compatibility.js",
    "./tool-errors": "./src/runtime/workflow/tool-errors.js",
    "./policy-contract": "./src/runtime/workflow/policy-contract-public-api.js",
    "./schema-contract": "./src/runtime/workflow/schema-contract.js",
    "./compiler": "./src/runtime/workflow/compiler.js",
    "./resource-recommender": "./src/runtime/workflow/resource-recommender.js",
    "./custom-workflow-contract": "./src/runtime/workflow/custom-workflow-contract.js",
    "./custom-role-contract": "./src/runtime/workflow/custom-role-contract.js"
  },
  "files": [
    "index.js",
    "job-store.js",
    "src/",
    "protocol/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.mjs && node --test tests/test-workflow-schema-contract-api.mjs && node --test tests/test-workflow-resource-recommender.mjs && node --test tests/test-custom-workflow-contract.mjs && node --test tests/test-custom-role-contract.mjs",
    "check": "npm run check:manifest && node --check index.js && npm test",
    "pack:check": "npm pack --dry-run",
    "test:packed-consumer": "node scripts/test-workflow-runtime-packed-consumer.mjs",
    "check:manifest": "node scripts/verify-source-manifest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nplongx/workflow-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/nplongx/workflow-runtime/issues"
  },
  "homepage": "https://github.com/nplongx/workflow-runtime#readme",
  "dependencies": {
    "@runalith/agent-contracts": "https://github.com/nplongx/runalith-agent-contracts/archive/7253657b5c3e2815cd21afed08d1e7027510d866.tar.gz",
    "@runalith/agent-runtime": "https://github.com/nplongx/agent-runtime/archive/f64d5e06c5af66d626ef575a08564273f4a466aa.tar.gz",
    "@runalith/execution-runtime": "https://github.com/nplongx/execution-runtime/archive/893e9d9ae79b14b512746438f63635dc7dde22d8.tar.gz",
    "@runalith/workflow-contracts": "https://github.com/nplongx/runalith-workflow-contracts/archive/4db6c79839fe27f1171be341b824dc3ebd6f8aa3.tar.gz",
    "@runalith/workspace-runtime": "https://github.com/nplongx/workspace-runtime/archive/9c47196f78f0098e327c229bbe7d69979ef204fb.tar.gz"
  },
  "keywords": [
    "workflow-runtime",
    "durable-workflows",
    "sqlite",
    "agent-runtime",
    "leases",
    "execution-state"
  ]
}
